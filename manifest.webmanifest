{
  "name": "MyFotoCards: hojas de fotos y photocards",
  "short_name": "MyFotoCards",
  "description": "Armá hojas de fotos estilo polaroid o photocards doble faz por grupo y álbum, listas para imprimir.",
  "lang": "es",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#eceef2",
  "theme_color": "#6b3fa0",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Hojas de fotos", "short_name": "Hojas", "url": "./", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Luli's Photocards", "short_name": "Photocards", "url": "./photocards.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "fotos", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif"] }
      ]
    }
  }
}
